rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document
    match /test/connection {
      allow read: if true;
    }

    // Common Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.role in ['citizen', 'merchant', 'agent']
        && data.neighborhood is string && data.neighborhood.size() <= 120
        && data.points is number && data.points >= 0
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 150));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().id == userId
        && incoming().role == 'citizen'; // Default safe role for new accounts

      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'neighborhood', 'points', 'avatar', 'businessName', 'updatedAt']);

      allow delete: if false;

      // Transactions subcollection
      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(txId)
          && incoming().id is string
          && incoming().userId == userId
          && incoming().type in ['earned', 'spent']
          && incoming().amount is number && incoming().amount > 0
          && incoming().description is string && incoming().description.size() <= 200
          && incoming().category is string && incoming().category.size() <= 60;
        allow update, delete: if false;
      }
    }

    // Donations & Swap Items (EcoTroca)
    function isValidDonation(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 140
        && data.category in ['moveis', 'eletronicos', 'roupas', 'livros', 'plantas', 'eletrodomesticos', 'outros']
        && data.type in ['doacao', 'troca']
        && data.description is string && data.description.size() <= 800
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 120
        && data.available is bool;
    }

    match /donations/{donationId} {
      allow read: if true; // Public listings in the Ipatinga community
      allow create: if isSignedIn()
        && isValidId(donationId)
        && isValidDonation(incoming())
        && incoming().authorId == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(donationId)
        && isValidDonation(incoming())
        && incoming().authorId == existing().authorId
        && existing().authorId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'type', 'condition', 'description', 'imageUrl', 'available', 'authorNeighborhood']);

      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Environmental Reports (Denúncias e Alertas)
    function isValidReport(data) {
      return data.id is string && data.id.size() <= 128
        && data.protocol is string && data.protocol.size() <= 50
        && data.type in ['descarte_irregular', 'lixo_acumulado', 'entulho_calcada', 'terreno_sujo', 'bueiro_entupido']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.description is string && data.description.size() <= 1000
        && data.address is string && data.address.size() <= 200
        && data.status in ['recebido', 'em_analise', 'equipe_a_caminho', 'resolvido']
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 120;
    }

    match /reports/{reportId} {
      allow read: if true; // Public map and transparency for Ipatinga neighborhoods
      allow create: if isSignedIn()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().status == 'recebido';

      allow update: if isSignedIn()
        && isValidId(reportId)
        && (
          // Action 1: Upvote by any signed-in resident
          (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes'])) ||
          // Action 2: Author edits description before resolution
          (existing().authorId == request.auth.uid
            && existing().status != 'resolvido'
            && isValidReport(incoming())
            && incoming().authorId == existing().authorId
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'address', 'imageUrl']))
        );

      allow delete: if isSignedIn() && existing().authorId == request.auth.uid && existing().status == 'recebido';
    }

    // Cata-Treco Pickup Requests
    match /pickups/{pickupId} {
      allow read: if isSignedIn() && (existing().authorId == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(pickupId)
        && incoming().authorId == request.auth.uid
        && incoming().status == 'agendado'
        && incoming().address is string && incoming().address.size() <= 200
        && incoming().phone is string && incoming().phone.size() <= 30;

      allow update: if isSignedIn()
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().diff(existing()).affectedKeys().hasOnly(['preferredDate', 'phone', 'address', 'instructions']);

      allow delete: if isSignedIn() && existing().authorId == request.auth.uid && existing().status == 'agendado';
    }
  }
}
